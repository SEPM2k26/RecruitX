// RecruitX Prisma schema — reconciled with the LIVE Supabase database.
//
// Architecture (Person 3, aligned with team contracts):
//   * These models MAP ONTO the existing public.* tables via @@map/@map.
//   * Do NOT rename those tables/columns: Person 1 (student portal, Supabase
//     Auth trigger + RLS on public.students) and Person 2 (admin portal, pg
//     queries against public.*) depend on them.
//   * Status/role/mode values are plain varchar in the database, so they are
//     modelled as String (NOT Prisma enums) to match reality.
//   * Nullable-in-DB columns are optional here; reads never crash on NULLs.
//   * Only ONE new table is additive: public.recruiters (recruiter auth +
//     company isolation). Its DDL lives in the additive migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrate/DDL must bypass the pgbouncer transaction pooler.
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────────────────
// Models (table names map onto the existing public schema)
// ───────────────────────────────────────────────────────────────────────────

model Student {
  id             String    @id @db.VarChar(100)
  name           String    @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  password       String?
  role           String?   @default("student") @db.VarChar(50)
  cgpa           Decimal?  @default(0) @db.Decimal(4, 2)
  branch         String?
  graduationYear Int?      @map("graduation_year")
  backlogs       Int?      @default(0)
  phone          String?
  skills         Json?     @default("[]")
  resumeUrl      String?   @map("resume_url")
  isActive       Boolean?  @default(true) @map("is_active")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  // Roster linkage (Person 1): registration_number has a case-insensitive
  // unique index in the database; modelled here as a plain field.
  registrationNumber String? @map("registration_number") @db.VarChar(100)

  // Social / resume metadata (Person 1 resume pipeline)
  linkedinUrl       String?   @map("linkedin_url")
  portfolioUrl      String?   @map("portfolio_url")
  resumeFileName    String?   @map("resume_file_name")
  resumeStoragePath String?   @map("resume_storage_path")
  resumeMimeType    String?   @map("resume_mime_type")
  resumeSize        BigInt?   @map("resume_size")
  resumeUploadedAt  DateTime? @map("resume_uploaded_at") @db.Timestamptz

  // Supabase Auth link (FK to auth.users exists in the database; its unique
  // index is partial, so we do NOT claim @unique here — that would make
  // Prisma expect a full unique index the database does not have).
  authUserId String? @map("auth_user_id") @db.Uuid

  applications Application[]
  interviews   Interview[]

  @@index([branch])
  @@index([graduationYear])
  @@index([isActive])

  @@map("students")
}

model Company {
  id          String    @id @db.VarChar(100)
  name        String    @db.VarChar(255)
  industry    String?   @db.VarChar(100)
  website     String?   @db.VarChar(255)
  description String?
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(50)
  location    String?   @db.VarChar(100)
  logoUrl     String?   @map("logo_url")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  drives     PlacementDrive[]
  recruiters Recruiter[]

  @@index([name])

  @@map("companies")
}
model PlacementDrive {
  id        String  @id @db.VarChar(100)
  companyId String? @map("company_id") @db.VarChar(100)
  jobRole   String  @map("job_role") @db.VarChar(255)
  // "package" holds human-readable values like "8 LPA" in the live data.
  package   String? @db.VarChar(100)
  location  String? @db.VarChar(100)
  // Deadlines are stored as plain date strings (varchar) in the database.
  applicationDeadline String?  @map("application_deadline") @db.VarChar(50)
  eligibleBranches    Json?    @map("eligible_branches") @default("[]")
  minCGPA             Decimal? @default(0) @map("min_cgpa") @db.Decimal(4, 2)
  maxBacklogs         Int?     @default(0) @map("max_backlogs")
  graduationYear      Int?     @map("graduation_year")
  description         String?
  status              String?  @default("active") @db.VarChar(50)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applications Application[]
  interviews   Interview[]

  @@index([companyId])
  @@index([status])
  @@index([graduationYear])

  @@map("placement_drives")
}

model Application {
  id        String  @id @db.VarChar(100)
  studentId String? @map("student_id") @db.VarChar(100)
  driveId   String? @map("drive_id") @db.VarChar(100)
  // Live values: Applied | Shortlisted | Selected | Rejected | Waitlisted
  status    String? @default("Applied") @db.VarChar(50)
  resumeUrl String? @map("resume_url")
  appliedAt DateTime? @default(now()) @map("applied_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  student     Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive       PlacementDrive?  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  // NOTE: interviews.application_id is a plain varchar in the database
  // (no FK constraint), so there is intentionally no Prisma relation here.
  // Query interviews by applicationId directly when needed.

  // Mirrors applications_student_id_drive_id_key in the database.
  @@unique([studentId, driveId])
  @@index([studentId])
  @@index([driveId])
  @@index([status])
  // Composite index for recruiter hot queries: "my drive's applicants by status".
  @@index([driveId, status])

  @@map("applications")
}

model Interview {
  id            String   @id @db.VarChar(100)
  studentId     String?  @map("student_id") @db.VarChar(100)
  driveId       String?  @map("drive_id") @db.VarChar(100)
  // Plain varchar in the database — no FK constraint exists.
  applicationId String?  @map("application_id") @db.VarChar(100)
  round         String   @db.VarChar(100)
  scheduledAt   DateTime? @map("scheduled_at") @db.Timestamptz
  mode          String?  @default("online") @db.VarChar(50)
  meetingLink   String?  @map("meeting_link")
  venue         String?
  status        String?  @default("scheduled") @db.VarChar(50)
  result        String?
  feedback      String?
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  student Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive   PlacementDrive? @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([driveId])
  @@index([status])

  @@map("interviews")
}
model Notification {
  id      String @id @db.VarChar(100)
  // user_id references either a student id or a recruiter id (no DB FK).
  userId  String? @map("user_id") @db.VarChar(100)
  type    String? @default("general") @db.VarChar(100)
  message String
  read    Boolean @default(false)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([read])

  @@map("notifications")
}

model Training {
  id        String  @id @db.VarChar(100)
  title     String  @db.VarChar(255)
  description String?
  instructor String? @db.VarChar(255)
  // Dates are stored as plain strings (varchar) in the database.
  startDate String? @map("start_date") @db.VarChar(50)
  endDate   String? @map("end_date") @db.VarChar(50)
  duration  String? @db.VarChar(100)
  mode      String? @default("online") @db.VarChar(50)
  maxStudents Int?  @default(50) @map("max_students")
  status    String? @default("upcoming") @db.VarChar(50)
  // JSON array of student ids (matches existing admin/student portal usage).
  enrolledStudents Json? @map("enrolled_students") @default("[]")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("trainings")
}

// The ONLY new table (additive migration). Recruiters authenticate with
// bcrypt + JWT exactly like admins do (public.admins pattern); Supabase Auth
// remains student-only per team contract. Company linkage gives every
// recruiter scoped access to their own drives/applicants only.
model Recruiter {
  id               String   @id @db.VarChar(100)
  name             String   @db.VarChar(255)
  email            String   @unique @db.VarChar(255)
  password         String
  role             String?  @default("recruiter") @db.VarChar(50)
  companyId        String   @map("company_id") @db.VarChar(100)
  jobTitle         String?  @map("job_title") @db.VarChar(255)
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isActive])

  @@map("recruiters")
}