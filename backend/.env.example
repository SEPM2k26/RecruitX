PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=true

# Client URL for CORS
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
STUDENT_CLIENT_URL=http://localhost:5173
RECRUITER_CLIENT_URL=http://localhost:5175
